# FORGE 環境設定テンプレート
# このファイルを `.env.local` にコピーして、自分の環境に合わせて書き換えてください。
# （Claude Code に SETUP.md を実行させれば、この作業は自動で行われます）

# ComfyUI の接続先（既定でローカル）
COMFY_HOST=http://127.0.0.1:8188

# ComfyUI の output フォルダ（生成した音声の実体を読む）
# 例(Windows): C:\Users\<あなた>\ComfyUI_windows_portable\ComfyUI\output
# 例(mac/Linux): /home/<あなた>/ComfyUI/output
COMFY_OUTPUT=<あなたのComfyUI>/output

# ComfyUI の input フォルダ（参照音声=声寄せのアップロード先）
COMFY_INPUT=<あなたのComfyUI>/input

# ジョブ台帳などの保存先（そのままでOK）
DATA_DIR=./data

# Irodori-TTS サーバー（ナレーションを使う場合のみ。既定でローカル）
# IRODORI_HOST=http://127.0.0.1:8088
